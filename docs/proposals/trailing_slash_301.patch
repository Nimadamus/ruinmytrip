+$rawPath = (string) strtok($_SERVER['REQUEST_URI'] ?? '/', '?');
+if ($rawPath !== '/' && str_ends_with($rawPath, '/') && in_array($_SERVER['REQUEST_METHOD'] ?? 'GET', ['GET', 'HEAD'], true)) {
+    $qs = (string) ($_SERVER['QUERY_STRING'] ?? '');
+    header('Location: /' . trim($rawPath, '/') . ($qs !== '' ? '?' . $qs : ''), true, 301);
+    exit;
+}
